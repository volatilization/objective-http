{
    "name": "objective-http",
    "version": "3.0.2",
    "description": "Proxy objects for creating a http server",
    "keywords": [
        "web",
        "web-server",
        "http",
        "http-server",
        "oop"
    ],
    "author": {
        "name": "volatilization",
        "email": "volatilization@yandex.ru"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/volatilization/objective-http"
    },
    "license": "LGPL-3.0-only",
    "scripts": {
        "lint": "eslint  --config .configs/eslint.mjs",
        "test": "node --test  --experimental-test-coverage --test-reporter=spec test/*.js test/**/*.js",
        "test:coverage": "./.scripts/coverage.sh",
        "release": "release-it --config .configs/release-it.mjs --no-npm --no-github",
        "release:no-increment": "release-it --ci --config .configs/release-it.mjs --no-increment --no-git",
        "build": "webpack --config .configs/webpack.mjs",
        "build:cleanup": "rm -rf dist"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@eslint/markdown": "^8.0.3",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "prettier-eslint-cli": "^9.2.1",
        "release-it": "^21.1.0",
        "terser-webpack-plugin": "^5.6.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}
