{
    "name": "objective-http",
    "version": "2.1.6",
    "description": "Proxy classes for creating a http server",
    "keywords": [
        "web",
        "web-server",
        "http",
        "http-server",
        "oop"
    ],
    "author": {
        "name": "volatilization",
        "email": "volatilization@yandex.ru"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/volatilization/objective-http"
    },
    "license": "LGPL-3.0-only",
    "scripts": {
        "lint": "eslint  --config .configs/eslint.mjs",
        "test": "node --test  --experimental-test-coverage --test-reporter=spec test/*.js test/**/*.js",
        "test:coverage": "./.scripts/coverage.sh",
        "release": "release-it --config .configs/release-it.mjs",
        "release:no-increment": "release-it --ci --config .configs/release-it.mjs --no-increment --no-git",
        "build": "webpack --config .configs/webpack.mjs",
        "build:cleanup": "rm -rf dist"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^1.60.2",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^1.2.0",
        "@eslint/markdown": "^8.0.1",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "globals": "^17.4.0",
        "prettier": "^3.8.1",
        "prettier-eslint-cli": "^8.0.1",
        "release-it": "^19.2.4",
        "terser-webpack-plugin": "^5.4.0",
        "webpack": "^5.105.4",
        "webpack-cli": "^7.0.2"
    }
}
